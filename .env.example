# --- LLM provider (Gemini-first, Ollama optional; see agents/llm.py) ---
# Gemini has a free tier - get a key at https://aistudio.google.com/apikey
# Model names change over time and older ones can be deprecated/rate-limited
# for a given key. If you see 404 or 429 errors in AI Activity, check which
# models are actually available and under quota for your key at
# https://aistudio.google.com/app/apikey (Rate Limit tab) and update these.
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash

# Optional local/offline fallback
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Force a provider ("gemini" or "ollama"). Leave blank to auto-detect.
LLM_PROVIDER=

# --- PostgreSQL (source of truth) ---
POSTGRES_USER=webops
POSTGRES_PASSWORD=webops
POSTGRES_DB=webops
DATABASE_URL=postgresql+psycopg://webops:webops@localhost:5432/webops

# --- Redis (queue/locks/transient state only) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (evidence artifacts: screenshots, HTML, traces) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=dhruvgaur10
MINIO_ROOT_PASSWORD=dhruvgaur10
MINIO_BUCKET=evidence
MINIO_SECURE=false

# --- Mock site (disclosed safe browsing target for dev/demo) ---
MOCK_SITE_BASE_URL=http://127.0.0.1:5050

# --- Application config ---
LOG_DIR=logs

# raw MinIO artifacts (screenshots/HTML/traces) older than this are purged by
# the scheduler's retention job; the Evidence row itself is never deleted -
# only the object key/bytes, with artifact_purged=true set on the row.
RETENTION_DAYS_RAW_ARTIFACTS=90

# --- CORS ---
# Explicit comma-separated origins the frontend is served from - never a
# wildcard, since the API issues bearer tokens for authenticated actions.
# Defaults cover Docker Compose's frontend container and the local Vite dev
# server; add your deployed frontend origin(s) before any real deployment.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
