{
  "schemas": {
    "hotel_pricing_watch": {
      "record_type": "HotelRecord",
      "root_selector": ".hotel-card",
      "fields": [
        {"name": "hotel_name", "selector": ".hotel-name", "fallback_attr": "data-hotel-name", "type": "string", "required": true, "confidence_penalty_if_missing": 0.0},
        {"name": "price", "selector": ".price", "fallback_attr": "data-price", "type": "float", "normalizer": "currency_amount", "required": false, "confidence_penalty_if_missing": 0.3},
        {"name": "currency", "selector": ".price", "type": "string", "normalizer": "currency_code", "required": false, "confidence_penalty_if_missing": 0.0},
        {"name": "available", "selector": ".unavailable", "type": "bool_absence", "required": true, "confidence_penalty_if_ambiguous": 0.4},
        {"name": "promo", "selector": ".promo", "type": "string", "required": false, "confidence_penalty_if_missing": 0.0},
        {"name": "rating", "selector": ".rating", "type": "float", "pattern": "([0-9.]+)\\s*/\\s*5", "required": false, "confidence_penalty_if_unparseable": 0.1}
      ],
      "evidence_field": "evidence_snippet",
      "evidence_max_chars": 300,
      "comparison_key": "hotel_name",
      "change_thresholds": {"price_change_pct": 3.0}
    },
    "campaign_page_monitoring": {
      "record_type": "CampaignRecord",
      "root_selector": ".campaign-card",
      "fields": [
        {"name": "headline", "selector": ".headline", "type": "string", "required": true, "confidence_penalty_if_missing": 0.5},
        {"name": "cta", "selector": ".cta-button", "type": "string", "required": false, "confidence_penalty_if_missing": 0.1},
        {"name": "valid_until", "selector": ".valid-until", "type": "date", "normalizer": "iso_date", "pattern": "([0-9]{4}-[0-9]{2}-[0-9]{2})", "required": false, "confidence_penalty_if_unparseable": 0.1}
      ],
      "evidence_field": "evidence_snippet",
      "evidence_max_chars": 300,
      "comparison_key": "slug",
      "change_thresholds": {}
    },
    "competitor_offer_tracking": {
      "record_type": "CompetitorOfferRecord",
      "root_selector": ".offer-card",
      "fields": [
        {"name": "offer_title", "selector": ".offer-title", "type": "string", "required": true, "confidence_penalty_if_missing": 0.5},
        {"name": "discount_pct", "selector": ".discount", "type": "float", "pattern": "([0-9.]+)\\s*%", "required": false, "confidence_penalty_if_missing": 0.4, "confidence_penalty_if_unparseable": 0.3}
      ],
      "evidence_field": "evidence_snippet",
      "evidence_max_chars": 300,
      "comparison_key": "competitor",
      "change_thresholds": {"discount_change_pct": 2.0}
    }
  },
  "common_fields": [
    {"name": "source_url", "description": "Exact URL the record was extracted from"},
    {"name": "extracted_at", "description": "UTC ISO-8601 timestamp of extraction"},
    {"name": "confidence", "description": "0.0-1.0 score, reduced per missing/unparseable field"},
    {"name": "validation_notes", "description": "Human-readable explanation of every confidence deduction"}
  ]
}
